{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#15171a",
    "--foreground": "#d2d6dc",
    "--editor-surface": "#15171a",

    "--card": "#1c1e22",
    "--card-foreground": "#d2d6dc",
    "--popover": "#1c1e22",
    "--popover-foreground": "#d2d6dc",

    "--primary": "#8db4d0",
    "--primary-foreground": "#15171a",
    "--secondary": "#2e333b",
    "--secondary-foreground": "#d2d6dc",
    "--muted": "#2e333b",
    "--muted-foreground": "#9aa1ab",
    "--accent": "#2e333b",
    "--accent-foreground": "#d2d6dc",

    "--border": "#2e333b",
    "--input": "#2e333b",
    "--ring": "#8db4d0",

    "--chart-1": "#8db4d0",
    "--chart-2": "#a7c59f",
    "--chart-3": "#cec59d",
    "--chart-4": "#baabcb",
    "--chart-5": "#a8c6d4",

    "--sidebar": "#101214",
    "--sidebar-foreground": "#d2d6dc",
    "--sidebar-primary": "#8db4d0",
    "--sidebar-primary-foreground": "#15171a",
    "--sidebar-accent": "#2e333b",
    "--sidebar-accent-foreground": "#d2d6dc",
    "--sidebar-border": "#2e333b",
    "--sidebar-ring": "#8db4d0",

    "--worktree-sidebar": "#101214",
    "--worktree-sidebar-foreground": "#d2d6dc",
    "--worktree-sidebar-accent": "#2e333b",
    "--worktree-sidebar-accent-foreground": "#d2d6dc",
    "--worktree-sidebar-border": "#2e333b",
    "--worktree-sidebar-ring": "#8db4d0",
    "--worktree-sidebar-active": "#2e333b",
    "--worktree-sidebar-active-border": "#8db4d0",

    "--host-badge": "#2e333b",
    "--host-badge-foreground": "#a8c6d4",

    "--tab-bar": "#101214",
    "--tab-active": "#1c1e22",
    "--tab-active-foreground": "#eceff3",
    "--tab-active-indicator": "#8db4d0",
    "--tab-inactive": "#101214",
    "--tab-inactive-foreground": "#9aa1ab",

    "--split-divider": "#2e333b",
    "--split-divider-hover": "#8db4d0",

    "--chat-user-message": "#1c1e22",
    "--chat-bold-foreground": "#eceff3",
    "--chat-muted-foreground": "#9aa1ab",
    "--chat-inline-code": "#2e333b",
    "--chat-inline-code-foreground": "#cec59d",
    "--chat-code-block": "#101214",
    "--chat-selection": "#2e333b",
    "--chat-selection-foreground": "#eceff3",

    "--text-link": "#8db4d0",
    "--editor-selection": "#2e333b",

    "--diff-added": "#a7c59f",
    "--diff-added-background": "#1e261f",
    "--diff-added-emphasis": "#2c3a29",
    "--diff-added-gutter": "#253024",
    "--diff-removed": "#e58888",
    "--diff-removed-background": "#282022",
    "--diff-removed-emphasis": "#402a2a",
    "--diff-removed-gutter": "#332325",

    "--git-decoration-added": "#a7c59f",
    "--git-decoration-modified": "#cec59d",
    "--git-decoration-deleted": "#e58888",
    "--git-decoration-renamed": "#baabcb",
    "--git-decoration-untracked": "#a8c6d4",
    "--git-decoration-copied": "#8db4d0",
    "--git-decoration-ignored": "#7e8590"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7e8590", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "markup.inline.raw"], "settings": { "foreground": "#a7c59f" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#b9d5b1" } },
    { "scope": ["keyword", "storage", "storage.type", "keyword.control"], "settings": { "foreground": "#baabcb" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#b4b9c0" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#8db4d0" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#cec59d" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#a8c6d4" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#d2d6dc" } },
    { "scope": ["variable.parameter", "variable.language"], "settings": { "foreground": "#cfba97" } },
    { "scope": ["entity.name.tag", "entity.other.attribute-name"], "settings": { "foreground": "#e58888" } },
    { "scope": ["markup.heading", "markup.bold"], "settings": { "foreground": "#a5c6de", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#f19f9f" } }
  ]
}

{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "graphite",
  "name": "Graphite",
  "version": "0.2.0",
  "description": "Graphite: a soft, low-glare dark theme for the Orca app and terminal, plus a darker variant.",
  "author": {
    "name": "Peter Urban"
  },
  "repository": "https://github.com/peterurban/orca-graphite-theme",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "data",
  "contributes": {
    "themes": [
      {
        "id": "graphite",
        "title": "Graphite",
        "path": "themes/graphite.json"
      },
      {
        "id": "graphite-darker",
        "title": "Graphite Darker",
        "path": "themes/graphite-darker.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "graphite",
        "title": "Graphite",
        "path": "terminal/graphite.json"
      },
      {
        "id": "graphite-darker",
        "title": "Graphite Darker",
        "path": "terminal/graphite-darker.json"
      }
    ]
  }
}
